<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    style="@style/ActivityRoot">

    <LinearLayout
        style="@style/ActivityInner">

        <include
            android:id="@+id/includeHeader"
            layout="@layout/include_header" />

        <ScrollView
            style="@style/ActivityScrollView">

            <LinearLayout
                android:id="@+id/llContainer"
                style="@style/ActivityContainer">

                <!-- ===== SECCION: INFO DEL AULA ===== -->
                <androidx.cardview.widget.CardView
                    style="@style/SectionCard"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        style="@style/SectionCardContent">

                        <LinearLayout
                            style="@style/SectionCardHeader">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_book"
                                app:tint="@color/studentPrimary" />

                            <TextView
                                android:id="@+id/tvAulaName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Nombre del Aula"
                                android:textColor="@color/textDark"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAulaSubject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Materia"
                            android:textColor="@color/studentPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAulaDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Descripción del aula..."
                            android:textColor="@color/textGray"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#E5E7EB" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_user"
                                app:tint="@color/studentPrimary" />

                            <TextView
                                android:id="@+id/tvVolunteerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Voluntario"
                                android:textColor="@color/studentDark"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== SECCION: HORARIOS DEL AULA ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSchedule"
                    style="@style/SectionCard"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        style="@style/SectionCardContent">

                        <LinearLayout
                            style="@style/SectionCardHeader">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/studentPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Horarios del Aula"
                                android:textColor="@color/textDark"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#E5E7EB" />

                        <LinearLayout
                            android:id="@+id/llScheduleSlots"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEmptySchedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="No hay horarios registrados"
                            android:textColor="@color/textGray"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== SECCION: PRÓXIMAS TUTORÍAS ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTutoring"
                    style="@style/SectionCard"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        style="@style/SectionCardContent">

                        <LinearLayout
                            style="@style/SectionCardHeader">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/studentPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Próximas Tutorías"
                                android:textColor="@color/textDark"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#E5E7EB" />

                        <LinearLayout
                            android:id="@+id/llTutoringSessions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEmptyTutoring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="No hay tutorías programadas"
                            android:textColor="@color/textGray"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== BOTON SOLICITAR TUTORIA ===== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRequestTutoring"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/studentPrimary"
                    android:text="Solicitar Tutoría"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_plus"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
