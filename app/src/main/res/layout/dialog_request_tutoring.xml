<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solicitar Tutoría"
        android:textColor="@color/textDark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#E5E7EB" />

    <!-- Topic / Reason -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Razón / Tema *"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#E5E7EB" />

    <!-- Date/time selection mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar fecha y hora:"
        android:textColor="@color/textDark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgDateTimeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbUseAvailableSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Usar horario disponible del voluntario"
            android:textColor="@color/textDark"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbCustomDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegir fecha/hora diferente"
            android:textColor="@color/textDark"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Available slots (shown when rbUseAvailableSlot is selected) -->
    <LinearLayout
        android:id="@+id/llAvailableSlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <Spinner
            android:id="@+id/spinnerAvailableSlots"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input" />
    </LinearLayout>

    <!-- Custom date/time (shown when rbCustomDateTime is selected) -->
    <LinearLayout
        android:id="@+id/llCustomDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Seleccionar fecha"
            android:textColor="@color/textDark"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvSelectTime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Seleccionar hora"
            android:textColor="@color/textDark"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#E5E7EB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelRequest"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancelar"
            android:textColor="@color/textGray"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveRequest"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/primaryCyan"
            android:text="Enviar"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
